# Cloudflare R2 Environment Variables
# Copy this file to .env or add these to your shell profile

# Enable/Disable R2 Storage
R2_ENABLED=true

# Cloudflare Account ID (from R2 Dashboard)
R2_ACCOUNT_ID=your_cloudflare_account_id

# R2 API Credentials (from Manage R2 API Tokens)
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# R2 Bucket Name
R2_BUCKET=vvu-scheduler

# R2 Endpoint (auto-constructed from account ID)
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com

# Optional: Public URL for R2 custom domain
# R2_PUBLIC_URL=https://files.yourdomain.com

# Fallback to local storage if R2 fails
R2_FALLBACK_LOCAL=true
