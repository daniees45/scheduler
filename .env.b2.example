# Environment Variable Template for Backblaze B2

# Copy these variables to your shell profile (~/.zshrc, ~/.bash_profile)
# or set them in your XAMPP environment

# Enable/Disable B2 Storage
B2_ENABLED=true

# Backblaze Account ID (from B2 Console)
B2_ACCOUNT_ID=your_account_id

# B2 Application Key ID (from App Keys page)
B2_APP_KEY_ID=your_app_key_id

# B2 Application Key (from App Keys page)
B2_APP_KEY=your_app_key

# B2 Bucket Name
B2_BUCKET=vvu-scheduler

# B2 Region (us-west-002, us-east-005, eu-central-003, ap-southeast-001, etc.)
B2_REGION=us-west-002

# B2 Endpoint (S3-compatible)
B2_ENDPOINT=https://s3.backblazeb2.com

# Optional: Public URL for B2 custom domain
# B2_PUBLIC_URL=https://files.yourdomain.com

# Fallback to local storage if B2 fails
B2_FALLBACK_LOCAL=true
